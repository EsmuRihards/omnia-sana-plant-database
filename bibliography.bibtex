@book{who1999allium,
  author   = {World Health Organization},
  title    = {Bulbus Allii Sativi},
  booktitle = {WHO monographs on selected medicinal plants, Volume 1},
  publisher = {World Health Organization},
  address  = {Geneva},
  year     = {1999},
  url      = {https://iris.who.int/items/6418d8af-5200-4e6b-9bf5-004f3aa62a37},
  note     = {REF-3101},
  study_type = {traditional},
  summary  = {WHO monograph on the fresh or dried bulbs of Allium sativum L. Posology: unless otherwise prescribed, average daily dose - fresh garlic 2-5 g; dried powder 0.4-1.2 g; oil 2-5 mg; extract 300-1000 mg as solid material; other preparations to correspond to 4-12 mg of alliin. Cited specifically because the EU herbal monograph (REF-3087) gives no posology for FRESH cloves.}
}

@book{who1999aloegel,
  author   = {World Health Organization},
  title    = {Aloe Vera Gel},
  booktitle = {WHO monographs on selected medicinal plants, Volume 1},
  publisher = {World Health Organization},
