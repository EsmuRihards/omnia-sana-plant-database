}

@misc{ema2012arnica,
  author   = {European Medicines Agency (HMPC)},
  title    = {Community herbal monograph on Arnica montana L., flos},
  year     = {2012},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-community-herbal-monograph-arnica-montana-l-flos_en.pdf},
