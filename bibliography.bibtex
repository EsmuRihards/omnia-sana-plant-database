  note     = {REF-3103},
  study_type = {traditional},
  summary  = {WHO monograph on the colourless mucilaginous gel obtained from the parenchymatous cells in the fresh leaves of Aloe vera (L.) Burm. f. Posology: fresh gel, or preparations containing 10-70% fresh gel. IMPORTANT: this is a separate monograph from WHO's 'Aloe', which covers the dried leaf JUICE (latex) as a stimulant laxative at 0.04-0.17 g. The two must not be conflated - different preparation, different action, doses differing by orders of magnitude.}
}

