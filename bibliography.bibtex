}

@misc{ema2011cinnamomum,
  author   = {European Medicines Agency (HMPC)},
  title    = {Community herbal monograph on Cinnamomum verum J.S. Presl, cortex},
  year     = {2011},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/community-herbal-monograph-cinnamomum-verum-js-presl-cortex_en.pdf},
