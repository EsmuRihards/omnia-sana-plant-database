@article{fong2002hawthorn,
  author   = {Fong, H.H.S. and Bauman, J.L.},
  title    = {Hawthorn},
  journal  = {Journal of Cardiovascular Nursing},
  year     = {2002},
  volume   = {16},
  number   = {4},
  pages    = {1-8},
  doi      = {10.1097/00005082-200207000-00002},
  note     = {REF-0782},
  study_type = {traditional},
  abstract = {Crataegus monogyna Jacq (Lindm), C. laevigata (Poir) DC, or related Crataegus species, collectively known as hawthorn, have been used in the treatment of cardiovascular diseases. Clinical studies have found that standardized extracts show promise as adjunctive agents for the treatment of left ventricular dysfunction. Other trials consistently demonstrate its ability to improve exercise tolerance and symptoms of mild to moderate heart failure. Preliminary evidence indicates that it improves left ventricular performance, as measured by ejection fraction. In order to properly use hawthorn in the treatment of heart failure, a large, controlled, multicenter trial in which mortality serves as the primary endpoint is needed.}
}

@misc{forageology_fireweed,
  author   = {{Forage-ology}},
  title    = {Foraging Fireweed: How to Identify and Use Every Part of This Stunning Wild Plant},
  url      = {https://forage-ology.com/foraging-fireweed-how-to-identify-and-use-every-part-of-this-stunning-wild-plant/},
  note     = {REF-2706},
  study_type = {traditional},
  abstract = {Foraging guide warning that young fireweed shoots emerging in spring can resemble highly toxic members of the lily family such as false hellebore (Veratrum), but fireweed is reliably identified by its unique leaf venation, in which the lateral veins loop back and join together inside the leaf margin rather than running to the edge; false hellebore has large, deeply pleated alternate leaves. Anchors the fireweed/false-hellebore shoot confusion and the looping-vein distinguishing test.}
}

@misc{foragerchef_milkweed,
  author   = {{Forager Chef}},
  title    = {Foraging and Cooking Milkweed},
  url      = {https://foragerchef.com/guide-to-milkweed/},
  note     = {REF-2695},
  study_type = {traditional},
  abstract = {Foraging guide: the main look-alike to be aware of with edible milkweed is dogbane (Apocynum cannabinum); at the shoot stage dogbane can resemble milkweed but dogbane shoots are thinner and firmer, branch early (which milkweed never does) and are horribly, terribly bitter - the bitterness is the decisive safety test. Anchors the milkweed/dogbane shoot confusion and the branching/bitterness distinguishing tests.}
}

@article{force2000oregano,
  author   = {Force, M., Sparks, W.S. and Ronzio, R.A.},
  title    = {Inhibition of enteric parasites by emulsified oil of oregano in vivo},
  journal  = {Phytotherapy Research},
  year     = {2000},
  volume   = {14},
  number   = {3},
  pages    = {213--214},
  doi      = {10.1002/(SICI)1099-1573(200005)14:3<213::AID-PTR583>3.0.CO;2-U},
  note     = {REF-0597},
  study_type = {clinical},
  abstract = {Oil of Mediterranean oregano Oreganum vulgare was orally administered to 14 adult patients whose stools tested positive for enteric parasites, Blastocystis hominis, Entamoeba hartmanni and Endolimax nana. After 6 weeks of supplementation with 600 mg emulsified oil of oregano daily, there was complete disappearance of Entamoeba hartmanni (four cases), Endolimax nana (one case), and Blastocystis hominis in eight cases. Also, Blastocystis hominis scores declined in three additional cases. Gastrointestinal symptoms improved in seven of the 11 patients who had tested positive for Blastocystis hominis.}
}

@misc{forestfarming_goldenseal,
  author   = {{Forest Farming (Cooperative Extension)}},
  title    = {Goldenseal (Hydrastis canadensis L.)},
  url      = {https://forest-farming.extension.org/goldenseal-hydrastis-canadensis-l/},
  note     = {REF-2702},
  study_type = {traditional},
  abstract = {Extension guide noting that goldenseal shares rich-woods habitat with, and its lobed maple-like leaves may be mistaken for, mayapple (Podophyllum peltatum), bloodroot (Sanguinaria canadensis) and other woodland plants, so novice foragers can confuse them; mayapple has large umbrella-like lobed leaves and bloodroot a single lobed leaf with red-orange sap, whereas goldenseal has a hairy upright stem bearing two ragged maple-like leaves and a bright-yellow rhizome. Anchors the goldenseal/mayapple/bloodroot confusion and distinguishing features.}
}

