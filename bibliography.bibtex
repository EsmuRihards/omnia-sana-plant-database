@misc{unruly_violets,
  author   = {{Unruly Gardening}},
  title    = {Foraging Violets: How to Identify, Harvest and Use},
  url      = {https://unrulygardening.com/foraging-violets/},
  note     = {REF-2686},
  study_type = {traditional},
  abstract = {Foraging guide warning that lesser celandine (Ficaria verna, fig buttercup), whose low-growing leaves closely resemble violet, is toxic to humans in most stages; it is distinguished by its glossy yellow flowers with 8-12 petals, whereas sweet violet has purple flowers with five uneven petals and heart-shaped leaves. Anchors the violet-versus-lesser-celandine confusion and the flower-colour/petal distinguishing test.}
}

@misc{ups_black_cohosh,
  author   = {{United Plant Savers}},
  title    = {Distinguishing Black Cohosh from Look-Alikes},
  url      = {https://unitedplantsavers.org/distinguishing-black-cohosh-from-look-alikes/},
  note     = {REF-2682},
  study_type = {traditional},
  abstract = {Plant-conservation guide: several North American Actaea, notably doll's eye (Actaea pachypoda) and red baneberry (Actaea rubra), are easily mistaken for black cohosh, a problem during vegetative-stage harvesting; all parts of doll's eye are toxic (vomiting, diarrhoea, seizures) and red baneberry is also toxic, especially for children, with ingestion able to cause severe gastroenteritis or death. Anchors the black-cohosh/baneberry confusion, the fruit/flower distinguishing marks and baneberry toxicity.}
}

@misc{uwex_autumn_crocus,
  author   = {{University of Wisconsin-Madison Division of Extension}},
  title    = {Autumn Crocus, Colchicum spp.},
  url      = {https://hort.extension.wisc.edu/articles/autumn-crocus-colchicum-spp/},
  note     = {REF-2651},
  study_type = {traditional},
  abstract = {University extension horticulture profile: autumn crocus flowers look very similar to spring crocus except that they have six stamens rather than the three stamens of the crocus, and C. autumnale or C. speciosum should definitely not be used in place of saffron in cooking because eating any part of this plant can be fatal. Anchors the three-versus-six stamen test and the fatal saffron-substitution warning.}
}

@article{uzelacbozac2024phenolic,
  author   = {Uzelac Božac, Mirela and Poljuha, Danijela and Dudaš, Slavica and Bilić, Josipa and Šola, Ivana and Mikulič-Petkovšek, Maja and Sladonja, Barbara},
  title    = {Phenolic Profile and Antioxidant Capacity of Invasive Solidago canadensis L.: Potential Applications in Phytopharmacy},
  journal  = {Plants (Basel, Switzerland)},
  year     = {2024},
  volume   = {14},
  number   = {1},
  doi      = {10.3390/plants14010044},
  pmid     = {39795304},
  url      = {https://pubmed.ncbi.nlm.nih.gov/39795304/},
  note     = {REF-3167},
  study_type = {preclinical},
  abstract = {Canadian goldenrodL.), an invasive plant in Europe, is known for its allelopathic activity and is rich in bioactive compounds like flavonoids and phenolic acids, with significant pharmacological potential. This study presents the LC-MS phenolic profiles of leaf and flower extracts from, an invasive alien plant in the Istria region (Croatia). Total phenolics (TP) (45.78-110.68 mg GAE/g DW) and non-flavonoids (TNF) (28.38-72.20 mg GAE/g DW) were found to be more abundant in ethanolic than in methanolic extracts. The antioxidant capacity (AC), as measured by ABTS, DPPH, and FRAP assays, was higher in flower extracts compared to leaf extracts. A non-targeted metabolomics approach was used, and 41 phenolic compounds in leaves and 36 in flowers were identified, with hydroxycinnamic acids and flavonols being the most abundant. 5-caffeoylquinic acid was quantitatively predominant in the leaf extracts, while quercetin-3-rutinoside dominated the flower extracts. Five leaf-specific compounds were identified (dicaffeoylquinic acid 2, 4--coumaroylquinic acid 1,-hydroxybenzoic acid, quercetin-3-rhamnoside, and quercetin acetylhexoside 1), suggesting targeted extraction for different pharmacological applications. This study highlights the therapeutic potential ofand underscores the need for further research on the bioavailability, efficacy, and safety of its compounds, potentially transforming this ecological threat into a valuable resource for drug development.}
}

@article{vagiri2014blackcurrant,
  author   = {Vagiri, M., Conner, S., Stewart, D., Andersson, S.C. and others},
  title    = {Phenolic compounds in blackcurrant (Ribes nigrum L.) leaves relative to leaf position and harvest date},
  journal  = {Food Chemistry},
  year     = {2015},
  volume   = {172},
  pages    = {135-142},
  doi      = {10.1016/j.foodchem.2014.09.041},
  note     = {REF-1252},
  study_type = {preclinical},
  abstract = {Blackcurrant leaves are an essential source of phenolic compounds and this study investigated their variation relative to leaf positions and harvest date. The phenolic content varied between harvest dates, although leaf position on the shoot and interactions also played an important role. The contents of quercetin-malonyl-glucoside, kaempferol-malonyl-glucoside isomer and kaempferol-malonyl-glucoside were higher than that of the other identified phenolic compounds, whereas epigallocatechin was the lowest for all investigated leaf positions and harvest dates. The content of several of the compounds was highest in June, while quercetin-glucoside, kaempferol-glucoside and total phenols, increased towards the end of the season. Leaf position influenced the content of myricetin-malonyl-glucoside, myricetin-malonyl-glucoside isomer, quercetin-malonyl-glucoside and kaempferol-glucoside at the end of the season. Knowledge relating to the influence of ontogenetic and harvest time on the content of specific phenolic compounds might contribute in tailoring functional foods or pharmaceutical products using blackcurrant leaves as natural ingredients.}
}

@article{valdivialopez2015chia,
  author   = {Valdivia-Lopez, M.A. and Tecante, A.},
  title    = {Chia (Salvia hispanica): A Review of Native Mexican Seed and its Nutritional and Functional Properties},
  journal  = {Advances in Food and Nutrition Research},
  year     = {2015},
  volume   = {75},
  pages    = {53-75},
  doi      = {10.1016/bs.afnr.2015.06.002},
  note     = {REF-1266},
  study_type = {systematic-review},
  abstract = {In this chapter, a review is made on various aspects of chia seed in order to provide an overall, yet comprehensive view, about this important commodity with the aim of updating the current state of knowledge on its composition, possible nutraceutical properties, and potential benefits for human health. Based on this approach, the discussion includes some comments on the main historical aspects, morphology of the seed, its importance in the diet of humans and stresses the main results issued from investigations on its three main components; lipid, protein, and fiber. The chapter closes with a discussion on the potential benefits for human health, highlighting the contradictions that still exist in this area and the need for continued research in this direction and considerations on the role of chia seed as a functional food.}
}

