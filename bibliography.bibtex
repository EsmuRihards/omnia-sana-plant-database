@misc{wisconsin_garlic,
  author   = {{University of Wisconsin-Madison Division of Extension, Wisconsin Horticulture}},
  title    = {Garlic, Allium sativum},
  url      = {https://hort.extension.wisc.edu/articles/garlic-allium-sativum/},
  note     = {REF-3372},
  kind     = {misc},
  study_type = {traditional},
  summary  = {University of Wisconsin-Madison Extension horticulture article on garlic (Allium sativum). Gives the observable lifting signal and the handling of the roots at harvest: "In general, garlic is ready to harvest when half of the leaves have turned brown," "Dig the bulbs with the shoots still attached. Loosen the soil underneath the bulb and carefully pull up the entire plant by the shoot," and "Cut the tops to 1/2-1\" above the main bulb and trim roots close to the base of the bulb." Cited for the harvest-readiness of the garlic root, which is lifted with the bulb rather than on a schedule of its own.}
}

