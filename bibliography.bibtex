@misc{ncsu_iris_pseudacorus,
  author   = {{North Carolina Extension Gardener Plant Toolbox}},
  title    = {Iris pseudacorus (Yellow Flag)},
  year     = {2024},
  url      = {https://plants.ces.ncsu.edu/plants/iris-pseudacorus/},
  note     = {REF-2668},
  study_type = {traditional},
  abstract = {University extension profile of yellow flag iris: a low-severity poison whose parts (highest concentration in the rhizomes) cause salivation, vomiting, drooling, lethargy and diarrhea, with pentacyclic terpenoids (zeorin, missourin, missouriensin) as the toxic principle; it has erect sword-shaped leaves and is not aromatic. Anchors the toxicity of yellow flag iris and the odourless, sword-leaf features distinguishing it from aromatic sweet flag.}
}

