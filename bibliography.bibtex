  note     = {REF-3092},
  study_type = {traditional},
  summary  = {EU herbal monograph for green tea leaf. Posology for adults and elderly: herbal tea 1.8-2.2 g of whole or comminuted herbal substance in 100-150 ml boiling water as an infusion, 3-5 times daily; powdered herbal substance single dose 390 mg, 3 times daily (up to 5 times if necessary). Not recommended under 18 years. Contraindicated in gastric and duodenal ulcers, cardiovascular disorders such as hypertension and arrhythmia, and hyperthyroidism. Consult a practitioner if symptoms persist beyond 1 week.}
}

@misc{ema2013eucalyptus,
  author   = {European Medicines Agency (HMPC)},
  title    = {Community herbal monograph on Eucalyptus globulus Labill., folium},
