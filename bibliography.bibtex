@article{seifi2017rosacanina,
  author     = {Seifi, M. and Abbasalizadeh, S. and Mohammad-Alizadeh-Charandabi, S. and Khodaie, L. and Mirghafourvand, M.},
  title      = {The effect of {Rosa} (L. {Rosa canina}) on the incidence of urinary tract infection in the puerperium: a randomized placebo-controlled trial},
  journal    = {Phytotherapy Research},
  year       = {2017},
  volume     = {32},
  number     = {1},
  pages      = {76--83},
  doi        = {10.1002/ptr.5950},
  note       = {REF-3105},
  study_type = {rct},
  abstract   = {This study was conducted to determine the effect of R. canina fruit in preventing the incidence of urinary tract infection (UTI) in women following cesarean section (CS). This triple-blind randomized clinical trial was conducted in 2016 on 400 women following CS with negative urine culture. Each group received a twice daily dose of 500 mg capsules containing R. canina or placebo from the second day after CS for 20 days. UTI was significantly lower in the intervention group compared with the control in the follow-ups conducted on the 7th-10th days (odds ratio = 0.22; CI 95% 0.07-0.67; p = .006) and 20th day (odds ratio = 0.32; CI 95% 0.14-0.75; p = .008). But the incidence of cystitis in the two groups was not statistically significant.}
}

@misc{sekoekondkumins,
  author   = {SekoEko},
  title    = {Kumīns, ķimenes un citi līdzinieki!},
