@misc{ncsu_acorus_calamus,
  author   = {{North Carolina Extension Gardener Plant Toolbox}},
  title    = {Acorus calamus (Sweet Flag)},
  year     = {2024},
  url      = {https://plants.ces.ncsu.edu/plants/acorus-calamus/},
  note     = {REF-2667},
  study_type = {traditional},
  abstract = {University extension profile of sweet flag: its leaves and rhizomes are sweetly scented when crushed (hence the name), and it has iris-like sword-shaped leaves in basal clumps with one wavy leaf margin and a prominent mid-rib. Anchors the aromatic-leaf and wavy-margin distinguishing tests and the iris-like leaf shape that underlies confusion with yellow flag iris.}
}

@misc{ncsu_apocynum,
  author   = {{North Carolina Extension Gardener Plant Toolbox}},
  title    = {Apocynum cannabinum (Dogbane)},
  url      = {https://plants.ces.ncsu.edu/plants/apocynum-cannabinum/},
  note     = {REF-2696},
  study_type = {traditional},
  abstract = {University extension profile of dogbane (Apocynum cannabinum): a high-severity poison whose toxic principles are resins and cardiac glycosides; all parts are highly toxic to humans and mammals, causing nausea, vomiting, weakness, diarrhoea and cardiac arrest, and the milky sap blisters skin and causes contact dermatitis. Anchors the cardiac-glycoside toxicity of dogbane.}
