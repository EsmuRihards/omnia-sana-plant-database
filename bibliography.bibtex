}

@article{shova2020antibacterial,
  author   = {Shova, D.C., Shrestha, S., Sharma, S. and Dhakal, H},
  title    = {GC-MS analysis, antibacterial, antioxidant study and brine shrimp lethality analysis of Trachyspermum ammi (L.) Sprague},
  year     = {2020},
