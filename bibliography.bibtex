  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-community-herbal-monograph-eleutherococcus-senticosus-rupr-et-maxim-maxim-radix_en.pdf},
  note     = {REF-3089},
  study_type = {traditional},
  summary  = {EU herbal monograph for eleuthero root (EMA/HMPC/680618/2013). DAILY doses for adolescents, adults and elderly: herbal tea 0.5-4 g of the comminuted herbal substance in 150 ml boiling water, divided into one to three doses; powdered herbal substance 0.75-3 g; liquid extract (DER 1:1, ethanol 30-40% v/v) 2-3 ml; dry extract (DER 13-25:1, ethanol 28-40% v/v) at doses corresponding to 0.5-4 g dried root; dry extract (DER 17-30:1, ethanol 70% v/v) at corresponding doses.}
}

@misc{ema2014humulus,
  author   = {European Medicines Agency (HMPC)},
  title    = {Community herbal monograph on Humulus lupulus L., flos, Revision 1},
  year     = {2014},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-community-herbal-monograph-humulus-lupulus-l-flos-revision-1_en.pdf},
  note     = {REF-3077},
  study_type = {traditional},
  summary  = {EU herbal monograph for hop flower (EMA/HMPC/682384/2013). Posology for adolescents, adults and elderly. To aid sleep: herbal tea 500-1000 mg of comminuted herbal substance in 150-200 ml boiling water as an infusion 30-60 minutes before bedtime; powdered herbal substance 800-2000 mg 30-60 minutes before bedtime. In mental stress: herbal tea 500 mg in 150-200 ml up to 4 times daily; powdered herbal substance 400 mg twice daily (adults) or 200 mg twice daily (adolescents); liquid extract (1:1) 0.5-2.0 ml up to 3 times daily; tincture (1:5) 1-2 ml up to 3 times daily; dry extract (4-5:1) 125 mg 2-3 times daily.}
}

@misc{ema2015capsicum,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Capsicum annuum L. var. minimum (Miller) Heiser and small fruited varieties of Capsicum frutescens L., fructus},
  year     = {2015},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-capsicum-annuum-l-var-minimum-miller-heiser-and-small-fruited-varieties-capsicum-frutescens-l-fructus_en.pdf},
  note     = {REF-3090},
  study_type = {traditional},
  summary  = {EU herbal monograph for cayenne/chilli fruit (EMA/HMPC/674139/2013). Covers hot chilli varieties, not sweet peppers. Cutaneous use, adults and elderly. Semi-solid dosage forms corresponding to 40-53 mg capsaicinoids per 100 g, applied in a thin layer to the affected area 2-4 times daily. Medicated plaster containing soft extract corresponding to 11 mg capsaicinoids expressed as capsaicin (35 microgram/cm2, 22 x 14 cm) or 4.8 mg (22 microgram/cm2, 12 x 18 cm); maximum 1 plaster per day applied for at least 4 and up to 12 hours, with an interval of at least 12 hours before a new plaster is applied to the same area. Not recommended under 18 years.}
}

@misc{ema2015centaurium,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Centaurium erythraea Rafn s.l., herba (Centaurii herba)},
  year     = {2015},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/european-union-herbal-monograph-centaurium-erythraea-rafn-sl-herba_en.pdf},
  note     = {REF-3067},
  study_type = {traditional},
  summary  = {EU herbal monograph for centaury herb (EMA/HMPC/277493/2015), the posology-bearing companion to the assessment report at REF-0431. Posology for adults and elderly: herbal tea 1-4 g comminuted herb in 200 ml boiling water up to 4 times daily; powdered herbal substance single dose 0.25-2 g up to 3 times daily; liquid extract 2-4 ml up to 3 times daily; tincture 1.5-5 g up to 3 times daily; soft extract single dose 0.2 g, daily dose 1-2 g. Not recommended under 18 years. Contraindicated in peptic ulcer. Consult a practitioner if symptoms persist beyond 2 weeks.}
}

@misc{ema2015epilobium,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Epilobium angustifolium L. and/or Epilobium parviflorum Schreb., herba},
  year     = {2015},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-epilobium-angustifolium-l-andor-epilobium-parviflorum-schreb-herba_en.pdf},
  note     = {REF-3075},
  study_type = {traditional},
  summary  = {EU herbal monograph for willowherb (small-flowered and rosebay). Posology for adults and elderly: herbal tea 1.5-2.0 g of the comminuted herbal substance in 250 ml of boiling water as an infusion, 2 times daily. Long-term use is possible. No relevant use under 18 years. Directs that a doctor be consulted if fever, spasms, blood in the urine, painful urination or urinary retention occur.}
}

@misc{ema2015eschscholzia,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Eschscholzia californica Cham., herba},
  year     = {2015},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-eschscholzia-californica-cham-herba_en.pdf},
  note     = {REF-3099},
  study_type = {traditional},
  summary  = {EU herbal monograph for California poppy herb (EMA/HMPC/680372/2013). Posology for adults and elderly: powdered herbal substance, single dose 480-600 mg, daily dose 960-1500 mg; for sleep, one single dose with dinner and another 30-60 minutes before bedtime. Covers the powdered herbal substance only - the monograph gives NO infusion posology. Not recommended under 18 years. Consult a practitioner if symptoms persist beyond 2 weeks.}
}

@misc{ema2016allium,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Allium sativum L., bulbus},
  year     = {2017},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-allium-sativum-l-bulbus_en.pdf},
  note     = {REF-3087},
  study_type = {traditional},
  summary  = {EU herbal monograph for garlic bulb. Indication 1, adults and elderly: powdered herbal substance single dose 300-750 mg, daily dose 900-1380 mg divided into 3 to 5 doses; liquid extract single dose 110-220 mg 4 times daily, daily dose 440-880 mg; no restriction on duration of use; not recommended under 18 years. Indication 2, adolescents, adults and elderly: dry extract single dose 100-200 mg 1-2 times daily, daily dose 100-400 mg; not recommended under 12 years. CONTRAINDICATED in patients under saquinavir/ritonavir therapy. The monograph gives no posology for fresh garlic cloves.}
}

@misc{ema2017calendula,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Calendula officinalis L., flos, Revision 1},
  year     = {2018},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-calendula-officinalis-l-flos-revision-1_en.pdf},
  note     = {REF-3065},
  study_type = {traditional},
  summary  = {Current EU herbal monograph for calendula flower (EMA/HMPC/437450/2017). Posology is cutaneous and oromucosal only. Cutaneous: 1-2 g herbal substance in 150 ml water as an infusion for impregnated dressings, 2-4 times daily; semi-solid dosage forms equivalent to 2-10% (or 2-5%, 2-8%, 4-20% depending on preparation) herbal substance, applied as a thin layer 2-4 times daily. Oromucosal: 1-2 g in 150 ml water used still warm for rinsing and gargling, 2-4 times daily. Not recommended under 6 years (cutaneous) or 12 years (oromucosal).}
}

@misc{ema2018aloysia,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Aloysia citrodora Paláu (syn. Aloysia triphylla (L'Hér.) Kuntze; Verbena triphylla L'Hér.; Lippia citriodora Kunth), folium},
  year     = {2018},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-aloysia-citrodora-palau-syn-aloysia-triphylla-lher-kuntze-verbena-triphylla-lher-lippia-citriodora-kunth-folium_en.pdf},
  note     = {REF-3079},
  study_type = {traditional},
  summary  = {EU herbal monograph for lemon verbena leaf (Verbenae citriodorae folium). NOTE: this is Aloysia citrodora, NOT Verbena officinalis (common vervain) - the similar Latin drug name is the likely origin of the phantom citation REF-0522. Posology for adolescents, adults and elderly. Mild symptoms of mental stress: 5 g of the comminuted leaf in 100 ml boiling water as a decoction, 3 times daily. To aid sleep: 1-2 g in 200 ml as an infusion half an hour before bedtime. Mild digestive complaints: 2-3 g in 200 ml as an infusion 1-3 times daily, or 1 g in 200 ml up to 5 times daily. Herbal tea preparations only - the monograph lists no tincture or extract. Not recommended in children. Consult a practitioner if symptoms persist beyond 2 weeks.}
}

@misc{ema2018centella,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Centella asiatica (L.) Urb., herba, Revision 1},
  year     = {2018},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/european-union-herbal-monograph-centella-asiatica-l-urb-herba-revision-1_en.pdf},
  note     = {REF-3085},
  study_type = {traditional},
  summary  = {EU herbal monograph for gotu kola herb. CUTANEOUS USE ONLY - the monograph gives no oral posology. Adults and elderly: single dose 0.6 g of the comminuted herbal substance in a small amount of boiling water, the still-warm infusion applied as an impregnated dressing 3 times daily (daily dose 1.8 g); or 0.6 g of the powdered herbal substance applied to the affected area 3 times daily (daily dose 1.8 g). Not to be used for more than 1 week. Not recommended under 18 years.}
}

@misc{ema2018cimicifuga,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Cimicifuga racemosa (L.) Nutt., rhizoma, Revision 1},
  year     = {2018},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-cimicifuga-racemosa-l-nutt-rhizome-revision-1_en.pdf},
  note     = {REF-3100},
  study_type = {traditional},
  summary  = {EU herbal monograph for black cohosh rhizome (EMA/HMPC/48745/2017), i.e. Actaea racemosa under its Cimicifuga synonym. Well-established use, female adults only: dry extract preparation a) single dose 2.8 mg twice daily (daily dose 5.6 mg); preparation b) 6.5 mg once daily; preparation c) 2.5 or 5.0 mg 1-2 times daily (daily dose 5.0 mg). These are extract masses under specific DERs, not crude-drug equivalents - they are not directly comparable to the WHO monograph's 40 mg drug-equivalent figure. No relevant indication in men, children or adolescents. Should not be taken for more than 6 months without medical advice. The monograph gives no tincture posology.}
}

@misc{ema2018foeniculum,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Foeniculum vulgare Miller subsp. vulgare var. vulgare, fructus, Revision 1},
  year     = {2018},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-foeniculum-vulgare-miller-subsp-vulgare-var-vulgare-fructus-revision-1_en.pdf},
  note     = {REF-3080},
  study_type = {traditional},
  summary  = {EU herbal monograph for bitter fennel fruit (EMA/HMPC/372841/2016). Posology for adults and adolescents: herbal tea 1.5 g of the herbal substance in 250 ml boiling water, steeped 15 minutes, 3 times daily; daily dose 4.5 g. Children 4-12 years: 1.0 g in 100 ml boiling water 3 times daily; daily dose 3.0 g. Use not recommended under 4 years. Exposure is limited because of the estragole content of the fruit.}
}

@misc{ema2019achillea,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Achillea millefolium L., herba, Revision 1},
  year     = {2019},
  url      = {https://www.ema.europa.eu/en/documents/herbal-opinion/final-european-union-herbal-monograph-achillea-millefolium-l-herba-revision-1_en.pdf},
  note     = {REF-3064},
  study_type = {traditional},
  summary  = {Current EU herbal monograph for yarrow herb (EMA/HMPC/376416/2019). Posology: herbal tea 1.5-4 g comminuted herb in 150-250 ml boiling water, 3-4 times daily between meals; expressed juice 5-10 ml 2-3 times daily; liquid extract 2-4 ml 3 times daily; tincture (ethanol 45% V/V) 2-4 ml 3 times daily; dry extracts 334 mg 3-4 times daily or 250 mg 2-3 times daily; cutaneous infusion 3-4 g per 250 ml 2-3 times daily. Not recommended under 12 years.}
}

@misc{ema2021juniperus,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Juniperus communis L., galbulus (pseudo-fructus), Revision 1},
  year     = {2023},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-european-union-herbal-monograph-juniperus-communis-l-pseudo-fructus-galbulus-revision-1_en.pdf},
  note     = {REF-3066},
  study_type = {traditional},
  summary  = {Current EU herbal monograph for juniper cone berry (EMA/HMPC/241320/2021), superseding the 2010 Community monograph (REF-0073). Posology for adults and elderly: 2.0-2.5 g comminuted herbal substance in 150 ml boiling water as an infusion 1-3 times daily (single dose 2-2.5 g, daily dose 2.5-6 g); liquid extract 2-4 ml 3 times daily (6-12 ml daily); tincture 1-2 ml 3 times daily (3-6 ml daily); soft extract 0.57 g once daily. Consult a practitioner if symptoms persist beyond 2 weeks; ensure adequate fluid intake; contraindicated in severe renal disease.}
}

@misc{ema2021pyrrolizidine,
  author   = {European Medicines Agency (HMPC)},
  title    = {Public statement on the use of herbal medicinal products containing toxic, unsaturated pyrrolizidine alkaloids (PAs), including recommendations regarding contamination of herbal medicinal products with PAs, Revision 1},
  year     = {2021},
  url      = {https://www.ema.europa.eu/en/documents/public-statement/public-statement-use-herbal-medicinal-products-containing-toxic-unsaturated-pyrrolizidine-alkaloids-pas-including-recommendations-regarding-contamination-herbal-medicinal-products-pyrrolizidine_en.pdf},
  note     = {REF-3070},
  study_type = {traditional},
  summary  = {EMA/HMPC/893108/2011 Rev. 1. The EU-level regulatory source for duration and intake limits on PA-containing herbs, naming Tussilago among the PA-containing genera traditionally used as medicines (alongside Symphytum, Borago and Petasites). Records the German regulation for medicinal products containing 1,2-unsaturated PAs: maximum daily dose for internal use 1 microgram of PAs for a duration of at most 6 weeks per year, or 0.1 microgram per day with no duration limit; for cutaneous application 100 micrograms for at most 6 weeks per year, or 10 micrograms with no duration limit. Also sets an acceptable contamination-derived intake of maximum 1.0 microgram PAs per day.}
}

@misc{ema2023aesculus,
  author   = {European Medicines Agency (HMPC)},
  title    = {European Union herbal monograph on Aesculus hippocastanum L., semen, Revision 1},
  year     = {2023},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/european-union-herbal-monograph-aesculus-hippocastanum-l-semen-final-revision-1_en.pdf},
  note     = {REF-3086},
  study_type = {traditional},
  summary  = {EU herbal monograph for horse chestnut seed. Well-established use, oral, adults and elderly: standardised dry extract corresponding to 21 mg triterpene glycosides calculated as protoaescigenin, 2 times daily; at least 4 weeks of treatment may be required before benefit is observed; long-term use possible in consultation with a doctor; no relevant indication under 12 years, not recommended under 18. Traditional use, cutaneous: semi-solid dosage forms equivalent to 0.4% triterpene glycosides as protoaescigenin, or 0.85-20% herbal preparation depending on form, applied as a thin layer 1-3 times daily. Also lists liquid extract 300 mg twice daily and 154 mg 3-4 times daily.}
}

@article{enes2020chia,
  author   = {Enes, B.N., Moreira, L.P.D., Silva, B.P., Grancieri, M. and others},
  title    = {Chia seed (Salvia hispanica L.) effects and their molecular mechanisms on unbalanced diet experimental studies: A systematic review},
  journal  = {Journal of Food Science},
  year     = {2020},
  volume   = {85},
  number   = {2},
  pages    = {226-239},
  doi      = {10.1111/1750-3841.15003},
  note     = {REF-1264},
  study_type = {systematic-review},
  abstract = {The aim of this review was to compile evidence and understand chia seed effects on unbalanced diet animal studies and the molecular mechanisms on metabolic biomarker modulation. A systematic review was conducted in electronic databases, following PRISMA recommendations. Risk of bias and quality was assessed using SYRCLE toll and ARRIVE guidelines. Seventeen articles were included. Throughout the studies, chia's main effects are associated with AMPK modulation: improvement of glucose and insulin tolerance, lipogenesis, antioxidant activity, and inflammation. Details about randomization and allocation concealment were insufficient, as well as information about blind protocols. Sample size, chia dose, and number of animals evaluated for each parameter were found to be lacking information among the studies. Based on experimental study data, chia has bioactive potential, and its daily consumption may reduce the risk of chronic disease development, mainly due to the antioxidant, anti-inflammatory, hypoglycemic, and hypolipidemic effects of the seed. PRACTICAL APPLICATION: The consumption of chia seeds may improve lipid profile, insulin and glucose tolerance, and reduce risk of cardiovascular disease. Whole seed or its oil presents positive effect, but the effects of chia oil can act faster than the seed.}
}

@article{engelhardt2022aegopodium,
  author   = {Engelhardt, L., Pöhnl, T. and Neugart, S.},
  title    = {Edible Wild Vegetables Urtica dioica L. and Aegopodium podagraria L.: Antioxidants Affected by Processing},
  journal  = {Plants (Basel)},
  year     = {2022},
  volume   = {11},
  number   = {20},
  pages    = {2710},
  doi      = {10.3390/plants11202710},
  note     = {REF-0720},
  study_type = {preclinical},
  abstract = {Urtica dioica L. and Aegopodium podagraria L., also known as stinging nettle and ground elder, are edible wild green vegetables rich in bioactive and antioxidant polyphenols, vitamins, and minerals. Antioxidant activity assays (TEAC-, DPPH-, and TPC-assay) in combination with HPLC measurements, to qualify and quantify their chemical compositions, were used. Firstly, the drying methods affected the antioxidant activity of further processing stages, and outcomes were dependent on the species. Secondly, cooking increased the antioxidant activity due to higher concentrations of bioactive compounds, and released bound compounds through the rupture of cell structures. Furthermore, fridge storage (3 days at 7 °C) resulted in the lowest antioxidant activity, compared to freezer storage (30 days at -20 °C). Added 5-caffeoylquinic acid (0.3 mM) led to an increased antioxidant activity, most noticeably in freeze-dried samples. Synergistic effects of 5-caffeoylquinic acid were primary found in freeze-dried samples, analyzed fresh or after storage in the fridge. Metal-chelates can lower the antioxidant activity in plant matrices. Edible wild green vegetables are rich in polyphenols and processing can even increase their concentrations to boost the potential health effects. In general, selected quantified phenolics are not solely responsible for the antioxidant activity; minerals, processing, and interactions in plant matrices also contribute decisively.}
}

@article{epifanio2020parsley,
  author   = {Mara de Menezes Epifanio, N., Rykiel Iglesias Cavalcanti, L., Falcao Dos Santos, K., Soares Coutinho Duarte, P. and others},
  title    = {Chemical characterization and in vivo antioxidant activity of parsley (Petroselinum crispum) aqueous extract},
  journal  = {Food & Function},
  year     = {2020},
  volume   = {11},
  number   = {6},
  pages    = {5346-5356},
  doi      = {10.1039/d0fo00484g},
  note     = {REF-1489},
  study_type = {preclinical},
  abstract = {Twenty-nine flavonoid glycosides were identified in the aqueous extract (PC) of Petroselinum crispum var. crispum leaves and apiin, the major compound, was isolated thereof. Apigenin was obtained (90% purity) by the hydrolysis of apiin. A high content of phenolics (12.49 ± 1.70 mg GAE per g of parsley extract - Folin-Ciocalteu method) and total flavonoids (15.05 ± 2.20 mg of quercetin equivalents per g of parsley extract - aluminum chloride method) was quantified in P. crispum, as well as high antioxidant activity ((EC50 - 15.50 mg mL-1, DPPH method) and (189.8 mM Fe(ii) per mg of dry plant aqueous extract - FRAP method)). In vivo analysis with Saccharomyces cerevisiae cells showed low toxicity of the aqueous extract of parsley, however, it revealed a high dose-dependent antioxidant potential, mainly in the lipoperoxidation assay. In addition, flavonoid apiin also showed antioxidant action on yeast cells under oxidative stress in the cell viability assay (0.1 mM) and lipid peroxidation (0.01 and 0.1 mM), while apigenin was slightly antioxidant. Therefore, it is likely that the antioxidant activity of apiin is related to the total antioxidant capacity of parsley.}
}

@article{epure2023taraxacum,
  author   = {Epure, A. and Parvu, A.E. and Vlase, L. and Benedec, D. and Hanganu, D. and Oniga, O. and Vlase, A.M. and Ielciu, I. and Toiu, A. and Oniga, I.},
  title    = {New Approaches on the Anti-Inflammatory and Cardioprotective Properties of Taraxacum officinale Tincture},
  journal  = {Pharmaceuticals},
  year     = {2023},
  volume   = {16},
  number   = {3},
  pages    = {358},
  doi      = {10.3390/ph16030358},
  note     = {REF-2389},
  study_type = {preclinical},
  abstract = {The present research investigated the in vivo anti-inflammatory and cardioprotective activities, as well as the antioxidant potential of Taraxacum officinale tincture (TOT), in relation to the polyphenolic composition. Chromatographic and spectrophotometric techniques were used to determine the polyphenolic profile of TOT and the antioxidant activity was preliminarily assessed in vitro by DPPH• and FRAP spectrophotometric methods. The in vivo anti-inflammatory and cardioprotective activities were studied in rat turpentine-induced inflammation and in rat isoprenaline-induced myocardial infarction (MI) models. The main polyphenolic compound identified in TOT was cichoric acid. The oxidative stress determinations showed the capacity of the dandelion tincture not only to decrease the total oxidative stress (TOS), the oxidative stress index (OSI), and the total antioxidant capacity (TAC), but also the malondialdehide (MDA), thiols (SH), and nitrites/nitrates (NOx) levels both in inflammation and MI models. In addition, aspartate aminotransferase (AST), alanine aminotransferase (ALT), creatin kinase-MB (CK-MB), and nuclear factor kappa B (NF-κB) parameters were decreased by the administration of the tincture. The results show that T. officinale could be considered a valuable source of natural compounds with important benefits in pathologies linked to oxidative stress.}
}

@article{erdemoglu2008arctiumminus,
  author   = {Erdemoglu, N., Turan, N.N., Akkol, E.K., Sener, B. and Abacioglu, N.},
  title    = {Estimation of anti-inflammatory, antinociceptive and antioxidant activities of Arctium minus (Hill) Bernh. ssp. minus},
  journal  = {Journal of Ethnopharmacology},
  year     = {2008},
  volume   = {121},
  number   = {2},
  pages    = {318-323},
  doi      = {10.1016/j.jep.2008.11.009},
  note     = {REF-1925},
  study_type = {preclinical},
  abstract = {Ethnopharmacological relevance Arctium minus (Hill) Bernh. ssp. minus (Asteraceae) leaves are used to alleviate rheumatic pain, against fever and sunstroke with externally application in Turkish folk medicine. Aim of the study To evaluate the anti-inflammatory, antinociceptive and antioxidant activities of aqueous and ethanol extracts prepared from the leaves of Arctium minus ssp. minus. Materials and methods The ethanolic and aqueous extracts from the leaves of Arctium minus ssp. minus were evaluated in mice for anti-inflammatory activity using carrageenan-induced hind paw edema model and for antinociceptive activity using p-benzoquinone-induced abdominal contractions test. Moreover, the antioxidant power of the extracts has been determined by using 1,1-diphenyl-2-picrylhydrazyl (DPPH) and flow injection analysis-luminol chemiluminescence (FIA-CL). In addition, the total phenolic content in both extracts was determined with spectrophotometric method. Results Our results showed that only the ethanol extract exhibited a dose-dependent anti-inflammatory activity ranging between 11.1 and 23.6% at 200mg/kg dose as well as displayed a significant antinociceptive activity without inducing any gastric damage. Although, both extracts were shown to possess significant DPPH radical-scavenging activity, that of aqueous extract was found to have more pronounced activity. In FIA-CL system, the ethanol extract was shown to possess a significant scavenger activity against H(2)O(2) while the aqueous extract was much more potent antioxidant activity against HOCl-luminol CL than ethanol extract. Conclusion According to our results, it was concluded that Arctium minus ssp. minus contains potent natural antioxidants. In this study, in vivo experimental results have also supported the folk medicinal utilization of Arctium minus ssp. minus.}
}

@article{ernst2000feverfew,
  author   = {Ernst, E. and Pittler, M.H.},
  title    = {The efficacy and safety of feverfew (Tanacetum parthenium L.): an update of a systematic review},
  journal  = {Public Health Nutrition},
  year     = {2000},
  volume   = {3},
  number   = {4A},
  pages    = {509-514},
  doi      = {10.1017/s1368980000000598},
  note     = {REF-1572},
  study_type = {systematic-review},
  abstract = {Objective Feverfew (Tanacetum parthenium L.) is a popular herbal remedy often advocated for the prevention of migraine. The aims of this systematic review are to update the evidence from rigorous clinical trials for or against the efficacy of feverfew for migraine prevention and to provide a safety profile of this herbal remedy. Design Literature searches were performed using the following databases: Medline, Embase, Biosis, CISCOM and the Cochrane Library (all from their inception to December 1999). Only randomized, placebo-controlled, double-blind trials of feverfew mono-preparations for the prevention of migraine in human subjects were included. All articles were read by two independent reviewers. Data were extracted in a pre-defined, standardized fashion. The methodological quality of the trials was evaluated by the Jadad score. For the assessment of safety issues, major reference texts were also consulted. Results Six trials met the inclusion/exclusion criteria. The majority favour feverfew over placebo. Yet important caveats exist. The data also suggest that feverfew is associated with only mild and transient adverse effects and few other safety concerns. Conclusions Feverfew is likely to be effective in the prevention of migraine. There are no major safety problems.}
}

@article{erol2024arctiumminus,
  author   = {Erol, E., Erol, K.F., Yanikoglu, R.S., Taskin, C., Kizilarslan Hancer, C. and Topcu, G.},
  title    = {Quantitative Determination of the Cytotoxic Compounds in Different Organs of Arctium minus (Hill) Bernh. by LC-HRESIMS Using Response Surface Methodology},
  journal  = {ACS Omega},
  year     = {2024},
  volume   = {9},
  number   = {40},
  pages    = {41890-41903},
  doi      = {10.1021/acsomega.4c06644},
  note     = {REF-1927},
  study_type = {preclinical},
  abstract = {Arctium minus (Hill) Bernh., commonly known as "Burdock", is a species within the Arctium genus of the Asteraceae family. Determining the optimum extraction conditions to obtain a concentrated extract with targeted active ingredients guides the most efficient use of natural products. Herein, ultrasound-assisted extraction (UAE) was optimized by using response surface methodology (RSM) to extract bioactive compounds from different organs of A. minus . Furthermore, phytochemical composition of extracts of the A. minus was investigated by using liquid chromatography-high resolution electrospray ionization mass spectrometry (LC-HRESIMS), antioxidant potential by using 2,2-diphenyl-1-picrylhydrazyl (DPPH), diazanium;3-ethyl-2-[(3-ethyl-6-sulfonato-1,3-benzothiazol-2-ylidene)hydrazinylidene]-1,3-benzothiazole-6-sulfonate (ABTS), CUPRAC, and metal chelation assays, and cytotoxic activities by using human breast cancer cell line (MDA-MB-231) and hepatocellular carcinoma cancer cell line (HepG2), and compared against conventional methods; Soxhlet and maceration. The RSM was employed to investigate the influence of ultrasound power, extraction time, and extraction temperature on the antioxidant potential assessed by the DPPH free radical scavenging assay. In UAE of A. minus leaves, flowers, and branches, the conditions resulting in the minimum IC 50 values: 20 °C for 6 min at 50 W for leaves, 20 °C for 3 min at 100 W for flowers, and 20 °C for 3 min at 100 W for branches. Chlorogenic acid was identified as the major phenolic compound in the extracts obtained by UAE, with concentrations of 24,666.96 μg/g in leaves, 1054.92 μg/g in flowers, and 3,501.24 μg/g in branches. Flowers of A. minus had significantly higher levels of arctiin and arctigenin than those of leaves and branches. Extracts from leaves and flowers were more effective against MDA-MB-231 and HepG2 cancer cell lines than arctiin and arctigenin.}
}

@article{ertas2023rosacanina,
  author     = {Ertas, B. and Hazar-Yavuz, A. N. and Topal, F. and Keles-Kaya, R. and Karakus, {\"O}. and Ozcan, G. S. and Taskin, T. and Cam, M. E.},
  title      = {{Rosa canina} L. improves learning and memory-associated cognitive impairment by regulating glucose levels and reducing hippocampal insulin resistance in high-fat diet/streptozotocin-induced diabetic rats},
  journal    = {Journal of Ethnopharmacology},
  year       = {2023},
  volume     = {313},
  pages      = {116541},
  doi        = {10.1016/j.jep.2023.116541},
  note       = {REF-3111},
  study_type = {preclinical},
  abstract   = {We evaluated the impact of T2DM on AD-like alterations and examined the molecular mechanism of a possible effect of R. canina on cognitive alterations in diabetic rats. R. canina ethanol extract was obtained by maceration method. This study was performed with male Sprague-Dawley rats fed with a high-fat diet (HFD) for 8 weeks, low-dose streptozotocin (STZ; 35 mg/kg IP) injection for 4 weeks, and R. canina (250 mg/kg; per oral) and metformin (400 mg/kg; per oral) administration for 4 weeks. R. canina could manage glucose responsiveness by reducing post-prandial blood glucose levels, preventing weight loss, and raising serum insulin levels in T2DM-induced rats. Behavioural tests showed that R. canina significantly improves diabetes-related cognitive decline in recall and long-term memory. Treatment with R. canina significantly reversed HFD/STZ-induced increases in insulin, amyloid-beta, amyloid precursor protein levels, and acetylcholinesterase activity in the prefrontal cortex and hippocampus. Furthermore, histological analyses revealed the protection of R. canina against neuronal disruption in the cortical and hippocampal CA3 region caused by chronic hyperglycemia.}
}

@article{ertik2023parsley,
  author   = {Ertik, O., Pazarbasi, S.E., Sener, G. and Sacan, O.},
  title    = {Petroselinum crispum Extract Prevents Scopolamine-Induced Lens Damage in Rats},
  journal  = {Chemistry & Biodiversity},
  year     = {2023},
  volume   = {20},
  number   = {11},
  pages    = {e202300776},
  doi      = {10.1002/cbdv.202300776},
  note     = {REF-1487},
  study_type = {preclinical},
  abstract = {Alzheimer's disease (AD) is a neurodegenerative disease that occurs especially in advanced ages. It reduces the quality of life of both the patient and their relatives. In addition to its primary effects, AD causes metabolic defects and tissues are damaged due to these effects. Oxidative stress damages cells by disrupting antioxidant/oxidant balance in many tissues, especially due to AD. In individuals with AD and the elderly, lens tissue is damaged due to oxidative stress and may cause vision loss. Therefore, it is very important to investigate herbal products that both prevent/cure AD and reduce AD-related oxidative stress, as they may have fewer side effects. In this study, the protective effects of parsley (Petroselinum crispum) extract on lens tissues of an experimental AD model induced by scopolamine were examined and evaluated through biochemical parameters. The result of biochemical experiments and principal component analysis, was observed that parsley extract had a therapeutic effect by reducing oxidative stress in lens tissues of experimentally induced AD rats. It can be suggested that the phenolic and flavonoid-rich content of parsley extract may have caused the reduction of oxidative damage in lens tissues and can be used to protect lens tissue against oxidative stress due to AD disease.}
}

