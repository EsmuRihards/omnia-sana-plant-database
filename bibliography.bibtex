  summary  = {EU herbal monograph for shepherd's purse (EMA/HMPC/262766/2010). Posology for adults: comminuted herbal substance 1-5 g as a single dose for herbal tea, 2-4 times daily (daily dose 3-20 g); liquid extract 1-4 ml as a single dose, 3 times daily (daily dose 3-12 ml). Use is to be started 3-5 days before menstruation and continued during menstrual bleeding. Not recommended under 18 years.}
}

@misc{ema2010euphrasia,
  author   = {European Medicines Agency (HMPC)},
  title    = {Public statement on Euphrasia officinalis L. and Euphrasia rostkoviana Hayne, herba},
  year     = {2010},
  url      = {https://www.ema.europa.eu/en/documents/herbal-report/final-public-statement-euphrasia-officinalis-l-and-euphrasia-rostkoviana-hayne-herba_en.pdf},
  note     = {REF-3084},
  study_type = {traditional},
  summary  = {EMA/HMPC/727465/2009. A NEGATIVE outcome, not a monograph: the HMPC set out to prepare a monograph on eyebright and concluded that none could be established. It states that the efficacy of the claimed uses is undocumented and that external eye application of ex tempore preparations is not hygienic and not safe, so therapeutic use cannot be recommended. Cited as the authoritative source for the ABSENCE of an official posology for Euphrasia, and for the safety position on home-prepared eye washes and compresses - it states no dose.}
}

