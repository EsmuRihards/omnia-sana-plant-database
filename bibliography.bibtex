  note     = {REF-3204},
  study_type = {traditional},
  summary  = {Grieve, A Modern Herbal (1931), Burdock entry for Arctium lappa. Confirms the first-year root as the drug and its collection: "The roots are dug in July," and "The dried root from plants of the first year's growth forms the official drug." Cited as an independent confirmation of the burdock root harvest stage (first-year root, mid-summer).}
