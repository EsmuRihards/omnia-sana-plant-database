}

@misc{ema2009viola,
  author   = {European Medicines Agency (HMPC)},
  title    = {Community herbal monograph on Viola tricolor L. and/or subspecies Viola arvensis Murray (Gaud) and Viola vulgaris Koch (Oborny), herba cum flore},
  year     = {2010},
  url      = {https://www.ema.europa.eu/en/documents/herbal-monograph/final-community-herbal-monograph-viola-tricolor-l_en.pdf},
  note     = {REF-3074},
  study_type = {traditional},
  summary  = {EU herbal monograph for heartsease (EMA/HMPC/131734/2009). Oral use, adults and elderly: herbal tea 3 g of comminuted herbal substance as an infusion 1-3 times daily; not recommended under 18 years. Cutaneous use, adolescents, adults and elderly: 5-20 g/l as an infusion applied as a wet dressing 2-3 times daily; bath additive 5-10 g/l, 1 litre of infusion added to the bath; not recommended under 12 years. Contraindicated in hypersensitivity to salicylates, and cutaneously on open wounds or large areas of damaged skin. Consult a practitioner if symptoms persist beyond 4 weeks.}
}

@misc{ema2010capsella,
  author   = {European Medicines Agency (HMPC)},
