  study_type = {traditional},
  summary  = {EU herbal monograph for motherwort herb (EMA/HMPC/127428/2010), the primary source updated by the review at REF-0860. Posology for adults and elderly: comminuted herbal substance for tea preparation, single dose 1.5-4.5 g, daily dose 3-10 g; powdered herbal substance single dose 150 mg 1-3 times per day; tincture 1:5 in ethanol 70% V/V, single dose 0.5-1.0 g, 3-4 times per day; tincture 1:5 in ethanol 45% V/V, single dose 2-6 ml, 3 times per day; liquid extract single dose 2-4 ml, 3 times per day. Not recommended under 18 years. Consult a practitioner if symptoms persist beyond 4 weeks.}
}

@misc{ema2011arctium,
