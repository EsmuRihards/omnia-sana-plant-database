  abstract = {University extension profile of box (Buxus sempervirens): the leaves are poisonous, the toxic principle being steroidal alkaloids; ingestion causes nausea, vomiting, diarrhoea, dizziness, convulsions and respiratory failure, and contact with the sap can irritate skin. Anchors the toxicity of box leaves.}
}

@misc{ncsu_centella_asiatica,
  author   = {{North Carolina Extension Gardener Plant Toolbox}},
  title    = {Centella asiatica (Gotu Kola, Asiatic Pennywort)},
  url      = {https://plants.ces.ncsu.edu/plants/centella-asiatica/},
  note     = {REF-2648},
  study_type = {traditional},
  abstract = {University extension plant-toolbox account of gotu kola (Centella asiatica): slender creeping stolons bear long-stalked green leaves with a rounded apex, smooth texture and palmately netted veins - i.e. a single rounded, smooth, scalloped blade per stalk. Anchors the single-undivided-scalloped-smooth-leaf feature that separates gotu kola from the three divided hairy leaflets of creeping buttercup.}
}

@misc{ncsu_conium_maculatum,
  author   = {{North Carolina Extension Gardener Plant Toolbox}},
  title    = {Conium maculatum (Poison Hemlock)},
  year     = {2024},
